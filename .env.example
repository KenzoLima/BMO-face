# Cerebro principal: gemini (padrao) ou groq
BMO_PROVIDER=gemini

# Chaves de API (a do provedor principal e obrigatoria; a outra vira fallback)
GOOGLE_API_KEY=sua_chave_aqui
GROQ_API_KEY=

# Modelos (opcionais - estes sao os padroes)
# BMO_MODEL_GEMINI=gemini-2.5-flash
# BMO_MODEL_GROQ=llama-3.3-70b-versatile

# Voz (opcionais - estes sao os padroes)
# BMO_VOZ=pt-BR-AntonioNeural
# BMO_VOZ_VELOCIDADE=+10%
# BMO_VOZ_TOM=+25Hz

# Wake word local - zero requisicoes em espera
# Motor 1 (preferido): Porcupine. Requer conta gratis em console.picovoice.ai:
#   copie a AccessKey e treine a palavra 'Bimo' (Portugues, Windows) -> .ppn em modelos/
PICOVOICE_ACCESS_KEY=
# BMO_WAKE_WORD_PPN=modelos/Bimo_pt_windows.ppn   (opcional: detectado sozinho)
# BMO_WAKE_SENSIBILIDADE=0.6                      (0 a 1; maior = dispara mais facil)
# Motor 2 (sem conta): Vosk. Ja instalado em modelos/vosk-model-small-pt-0.3.
# Ajuste fino do gatilho (padroes calibrados com tests/calibrar_wake_word.py):
# BMO_WAKE_VOSK=bio,bico,mimo,bi      (palavras-ancora)
# BMO_WAKE_CONF_MIN=0.30              (abaixo disso = ruido, ignora)
# BMO_WAKE_CONF_MAX=0.92              (acima disso = palavra real em conversa, ignora)
# BMO_WAKE_DURACAO_MIN=0.18           (segundos; ancoras mais curtas sao descartadas)
