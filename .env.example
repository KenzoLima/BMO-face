# Cerebro principal: gemini (padrao), groq ou local (Ollama, sem internet)
BMO_PROVIDER=gemini

# Chaves de API (a do provedor principal e obrigatoria; a outra vira fallback)
GOOGLE_API_KEY=sua_chave_aqui
GROQ_API_KEY=

# Modelos (opcionais - estes sao os padroes)
# BMO_MODEL_GEMINI=gemini-2.5-flash
# BMO_MODEL_GROQ=llama-3.3-70b-versatile

# --- Cerebro LOCAL / HIBRIDO (Ollama) ---------------------------------------
# BMO_PROVIDER=local faz o modelo rodar na sua maquina (zero requisicoes). Se o
# local falhar ou estourar o timeout, cai automaticamente para a nuvem (Gemini/
# Groq, se houver chave) - e o "modo hibrido". Requer o Ollama instalado
# (ollama.com) e o modelo puxado: `ollama pull qwen3:4b`.
# Num notebook com 8 GB e sem GPU, prefira um modelo 4B.
# BMO_MODEL_LOCAL=qwen3:4b
# BMO_LOCAL_BASE_URL=http://localhost:11434/v1
# BMO_LOCAL_API_KEY=ollama          (dummy; o Ollama nao exige chave)
# BMO_LOCAL_TIMEOUT=45              (segundos por resposta antes de escalar p/ nuvem)

# Voz (opcionais - estes sao os padroes)
# BMO_VOZ=pt-BR-AntonioNeural
# BMO_VOZ_VELOCIDADE=+10%
# BMO_VOZ_TOM=+25Hz

# --- Voz OFFLINE (Piper) -----------------------------------------------------
# BMO_TTS=piper faz a sintese de voz rodar 100% local (sem internet), com o
# Piper (github.com/rhasspy/piper). Baixe uma voz pt-BR (.onnx + .onnx.json) e
# aponte o caminho do .onnx. Padrao BMO_TTS=edge (voz neural na nuvem).
# BMO_TTS=edge
# BMO_PIPER_VOZ=C:\Users\voce\BMO\vozes\pt_BR-faber-medium.onnx

# --- Escuta OFFLINE (sem Google) ---------------------------------------------
# BMO_STT_SEM_GOOGLE=1 desliga a reserva na nuvem: o comando e transcrito so
# pelo faster-whisper (local). Exige wake word local + faster-whisper instalado.
# Num notebook com 8 GB sem GPU, um modelo Whisper menor responde mais rapido.
# BMO_STT_SEM_GOOGLE=
# BMO_WHISPER_MODELO=base            (tiny/base/small/medium; padrao small)

# Wake word local - zero requisicoes em espera
# Motor 1 (preferido): Porcupine. Requer conta gratis em console.picovoice.ai:
#   copie a AccessKey e treine a palavra 'Bimo' (Portugues, Windows) -> .ppn em modelos/
PICOVOICE_ACCESS_KEY=
# BMO_WAKE_WORD_PPN=modelos/Bimo_pt_windows.ppn   (opcional: detectado sozinho)
# BMO_WAKE_SENSIBILIDADE=0.6                      (0 a 1; maior = dispara mais facil)
# Motor 2 (sem conta): Vosk. Ja instalado em modelos/vosk-model-small-pt-0.3.
# Ajuste fino do gatilho (padroes calibrados com tests/calibrar_wake_word.py):
# BMO_WAKE_VOSK=bio,bico,mimo,bi      (palavras-ancora)
# BMO_WAKE_CONF_MIN=0.30              (abaixo disso = ruido, ignora)
# BMO_WAKE_CONF_MAX=0.92              (acima disso = palavra real em conversa, ignora)
# BMO_WAKE_DURACAO_MIN=0.18           (segundos; ancoras mais curtas sao descartadas)

# Modo conversa: apos responder, o BMO segue ouvindo sem exigir novo "bimo".
# Encerre com silencio ou frases como "obrigado" / "so isso" / "tchau".
# BMO_CONVERSA_TIMEOUT=6              (segundos de silencio que encerram o assunto)

# Caderno (memoria de longo prazo em Markdown, compativel com Obsidian).
# Aponte para uma subpasta do seu vault para as notas aparecerem no Obsidian.
# Toda a busca e local - nao gasta requisicoes de API.
# BMO_VAULT=C:\Users\user\Documents\MeuVault\BMO

# Vida propria (proatividade): o BMO toma pequenas iniciativas quando esta
# ocioso - bom dia com os lembretes do dia, sugestao de pausa e lembrancas do
# caderno. Nunca corta uma conversa e respeita um intervalo minimo entre falas.
# Desligue pela tela de configuracao ou aqui (vazio ou 0 = desligado).
BMO_PROATIVIDADE=1
# BMO_PROATIVIDADE_BRIEFING_HORA=8    (hora minima do "bom dia" do dia)
# BMO_PROATIVIDADE_PAUSA_HORAS=3      (horas de uso ate sugerir uma pausa)
# BMO_PROATIVIDADE_COOLDOWN_MIN=45    (intervalo minimo, em minutos, entre falas)
# BMO_PROATIVIDADE_CADERNO_HORAS=6    (intervalo minimo entre lembrancas do caderno)
# BMO_PROATIVIDADE_CHECAR_S=30        (de quantos em quantos segundos ele verifica)

# Medidor de requisicoes: um velocimetro no canto do rosto que comeca cheio e
# vai esvaziando conforme o BMO gasta chamadas ao LLM. Conta CHAMADAS DE API,
# nao falas: o loop de ferramentas pode gastar varias por comando.
# O contador zera sozinho na virada do dia (%APPDATA%\BMO\consumo.json).
# BMO_LIMITE_REQUISICOES_DIA=250      (teto do SEU plano - confira no provedor)
# BMO_MEDIDOR=auto                    (auto = so aparece com pouco saldo; sempre; nunca)
# BMO_MEDIDOR_LIMIAR=0.5              (no modo auto, abaixo de quanto ele aparece)

# Dispositivos de audio: escolha o microfone e a saida de som na tela de
# configuracoes (secao "Dispositivos de audio"). Guardamos o NOME, nao o
# indice - indices mudam de posicao quando voce pluga um fone ou webcam.
# Vazio = dispositivo padrao do Windows. Nome nao encontrado (desconectado)
# tambem cai no padrao, em vez de quebrar a escuta.
# BMO_AUDIO_ENTRADA=Microfone (Realtek HD Audio Mic input)
# BMO_AUDIO_SAIDA=Alto-falantes (Realtek(R) Audio)
